# TEMPLATE — Linux systemd user service. setup.sh renders it to
# ~/.config/systemd/user/skills-embed.service, replacing __DIR__.
# Pair with skills-embed.timer (6h cadence) and skills-embed.path (watch ~/.claude/skills).
# Enable: systemctl --user enable --now skills-embed.timer skills-embed.path
[Unit]
Description=Refresh SKILLS-INDEX.* and SKILLS-EMBEDDINGS.json from the skill library
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__DIR__
ExecStart=/bin/sh __DIR__/embed-refresh.sh

[Install]
WantedBy=default.target
