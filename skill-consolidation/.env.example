# Copy to .env and fill in. .env is gitignored — never commit real values.
# setup.sh sources this to render mcp-servers.template.json into your ~/.claude.json.
# Leave a line blank to SKIP that MCP server (setup.sh drops servers with unresolved vars).

# ── Tokens / API keys ────────────────────────────────────────────────────────
# Monday.com personal API token (used by both monday MCP servers).
MONDAY_API_TOKEN=
# Firecrawl API key (fc-...).
FIRECRAWL_API_KEY=
# Exa API key.
EXA_API_KEY=
# mdb-tam dashboard MCP token + base URL.
DASHBOARD_API_TOKEN=
DASHBOARD_URL=

# ── Machine-specific paths / URLs ────────────────────────────────────────────
# Local TAM MCP HTTP endpoint (default shown).
TAM_MCP_URL=http://127.0.0.1:3939/mcp
# Absolute path to the mdb-tam account-context MCP server entrypoint.
DASHBOARD_MCP_PATH=
# Absolute path to the mdb-case-assistant MCP server entrypoint.
CASE_ASSISTANT_MCP_PATH=
# Skills relay (defaults to ~/.claude/scripts/skills-relay.js if left blank).
SKILLS_RELAY_PATH=
