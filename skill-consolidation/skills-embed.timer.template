# TEMPLATE — Linux systemd user timer. setup.sh renders it to
# ~/.config/systemd/user/skills-embed.timer. Runs the refresh at boot and every 6h.
[Unit]
Description=Run skills-embed refresh at boot and every 6h

[Timer]
OnBootSec=1min
OnUnitActiveSec=6h
Persistent=true
Unit=skills-embed.service

[Install]
WantedBy=timers.target
