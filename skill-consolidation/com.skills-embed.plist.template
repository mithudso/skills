<?xml version="1.0" encoding="UTF-8"?>
<!-- TEMPLATE — do not load this file directly. setup.sh renders it to
     ~/Library/LaunchAgents/com.skills-embed.plist, replacing __HOME__ and __DIR__. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.skills-embed</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__DIR__/embed-refresh.sh</string>
  </array>

  <!-- Fires when a top-level skill dir is added / removed / renamed under ~/.claude/skills -->
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/.claude/skills</string>
  </array>

  <!-- 6h catch-all for edits inside an existing skill (dir mtime unchanged) -->
  <key>StartInterval</key>
  <integer>21600</integer>

  <!-- Catch anything changed while logged out; also fires at every login/boot -->
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__DIR__/embed-refresh.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/embed-refresh.log</string>
</dict>
</plist>
