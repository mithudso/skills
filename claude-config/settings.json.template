{
  "skillListingBudgetFraction": 0.12,
  "env": {
    "CLAUDE_CODE_PLUGIN_GIT_TIMEOUT_MS": "300000"
  },
  "permissions": {
    "allow": [
      "Write(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(node --check src/background/service-worker.js)",
      "Bash(grep -E \"\\\\.\\(js|ts\\)$\")",
      "Bash(gh pr:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(python3 *)",
      "mcp__tam_mcp__tam_list_skills",
      "mcp__tam_mcp__tam_optimize_prompt",
      "mcp__tam_mcp__tam_save_prompt",
      "Read(~/.claude/skills/skill-optimizer/**)",
      "mcp__tam_mcp__tam_recommend_skills",
      "mcp__tam_mcp__tam_search_skills",
      "mcp__tam_mcp__tam_concept_tree_get",
      "mcp__tam_mcp__tam_concept_tree_search",
      "mcp__tam_mcp__tam_search_all"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(ssh *.10gen.cc)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.config/gcloud/*)",
      "Read(~/.kube/*)",
      "Write(./.env*)",
      "Write(**/.env*)",
      "Write(~/.ssh/*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.p12)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(~/.kanopy/**)",
      "Write(~/.kanopy/**)",
      "Read(**/terraform.tfstate)",
      "Write(**/terraform.tfstate)",
      "Read(**/terraform.tfstate.backup)",
      "Write(**/terraform.tfstate.backup)",
      "Read(~/.git-credentials)",
      "Read(~/Library/Keychains)",
      "Write(~/Library/Keychains)"
    ],
    "ask": [
      "Bash(kubectl *)",
      "Bash(terraform apply *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",
      "Bash(ssh *)",
      "Bash(security)",
      "Bash(op)",
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Write(./secrets/**)",
      "Write(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(~/Library/Mail/**)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/skill-change-trigger-optimizers.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | { read -r f; [[ \"$f\" == __HOME__/.claude/skills/* ]] && rsync -a --delete __HOME__/.claude/skills/ /Volumes/mitch/.claude/skills/ 2>/dev/null || true; }",
            "statusMessage": "Syncing skills to volume...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Read|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node __HOME__/.claude/skills/skill-consolidation/tiering/log-access.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/session-tab-color.sh reset || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __HOME__/.claude/skills/skill-consolidation/tiering/tier.mjs --apply --quiet",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/session-tab-color.sh || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __HOME__/Documents/GitHub/mdb-context-hub/hooks/hub-context-hook.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/.claude/hooks/caveman-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-tasks.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "atlassian@claude-plugins-official": false,
    "slack@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "playground@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "php-lsp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": false,
    "remember@claude-plugins-official": true,
    "imessage@claude-plugins-official": false,
    "postman@claude-plugins-official": false,
    "data-engineering@claude-plugins-official": false,
    "atomic-agents@claude-plugins-official": false,
    "wordpress.com@claude-plugins-official": false,
    "mongodb@claude-plugins-official": true,
    "deploy-on-aws@claude-plugins-official": false,
    "brainstorming@mongodb-internal": false,
    "copilot-adversarial-review@mongodb-internal": true,
    "dispatching-parallel-agents@mongodb-internal": false,
    "edit-confluence@mongodb-internal": false,
    "executing-plans@mongodb-internal": false,
    "finishing-a-development-branch@mongodb-internal": false,
    "git-workflows@mongodb-internal": true,
    "go-patterns@mongodb-internal": false,
    "jira-cli@mongodb-internal": false,
    "jira-ticket-creation@mongodb-internal": false,
    "pr-review-loop@mongodb-internal": true,
    "pull-request-guidelines@mongodb-internal": true,
    "query-integration@mongodb-internal": false,
    "read-confluence@mongodb-internal": false,
    "receiving-code-review@mongodb-internal": false,
    "review-skill@mongodb-internal": true,
    "storage-engines@mongodb-internal": false,
    "subagent-driven-development@mongodb-internal": false,
    "survey-builder@mongodb-internal": true,
    "systematic-debugging@mongodb-internal": false,
    "threat-model-analyst@mongodb-internal": false,
    "tooling@mongodb-internal": false,
    "variant-right-sizer@mongodb-internal": false,
    "verification-before-completion@mongodb-internal": false,
    "while-you-code@mongodb-internal": false,
    "writing-plans@mongodb-internal": false,
    "wt-cli-tool@mongodb-internal": false,
    "desktop-commander@claude-plugins-official": false,
    "caveman@caveman": true,
    "session-report@claude-plugins-official": true,
    "aws-startup-advisor@claude-plugins-official": true,
    "cost-reducer@mongodb-internal": true,
    "before-you-code@mongodb-internal": true,
    "before-you-commit@mongodb-internal": true,
    "before-you-merge@mongodb-internal": true,
    "bf-triage@mongodb-internal": true,
    "security@mongodb-internal": true
  },
  "extraKnownMarketplaces": {
    "mongodb-internal": {
      "source": {
        "source": "github",
        "repo": "10gen/agent-skills"
      },
      "autoUpdate": true
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "advisorModel": "opus",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "verbose": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "todoFeatureEnabled": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "defaultMode": "bypassPermissions",
  "mcpServers": {
    "glean_default": {
      "httpUrl": "https://mongodb-be.glean.com/mcp/default"
    },
    "glean_developer_docs": {
      "httpUrl": "https://developers.glean.com/mcp"
    },
    "monday-apps-mcp": {
      "args": [
        "@mondaydotcomorg/monday-api-mcp",
        "-t",
        "${MONDAY_API_TOKEN}",
        "--mode",
        "apps"
      ],
      "command": "npx"
    },
    "MongoDB": {
      "args": [
        "-y",
        "mongodb-mcp-server@latest",
        "--readOnly"
      ],
      "command": "npx",
      "env": {
        "MDB_MCP_API_CLIENT_ID": "${MDB_MCP_API_CLIENT_ID}",
        "MDB_MCP_API_CLIENT_SECRET": "${MDB_MCP_API_CLIENT_SECRET}"
      }
    },
    "tam_mcp": {
      "httpUrl": "http://127.0.0.1:3939/mcp"
    },
    "mdb_case_assistant": {
      "command": "__HOME__/Documents/GitHub/mdb-case-assistant/node_modules/.bin/tsx",
      "args": [
        "__HOME__/Documents/GitHub/mdb-case-assistant/mcp-server/src/index.ts"
      ]
    },
    "monday-access-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@mondaydotcomorg/monday-api-mcp",
        "-t",
        "${MONDAY_API_TOKEN}"
      ]
    },
    "vibe": {
      "command": "npx",
      "args": [
        "@vibe/mcp"
      ]
    },
    "granola": {
      "type": "http",
      "url": "https://mcp.granola.ai/mcp"
    },
    "mdb_tam_account_context": {
      "command": "node",
      "args": [
        "__HOME__/Documents/dashboard/mdb-tam/packages/mcp-server/src/server.js"
      ],
      "env": {
        "DASHBOARD_API_TOKEN": "${DASHBOARD_API_TOKEN}",
        "DASHBOARD_URL": "http://127.0.0.1:8787"
      }
    }
  }
}
